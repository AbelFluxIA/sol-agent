// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cada conversa é ligada ao número de telefone (WhatsApp)
model Conversation {
  id        String   @id @default(cuid())
  phone     String   @unique  // número do whatsapp ex: 5583999999999
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados coletados no onboarding
  name            String?
  arrivalDate     String?
  departureDate   String?
  arrivalTime     String?
  departureTime   String?   // horário de volta no último dia, ex: "15:00"
  originCity      String?   // cidade de onde parte, ex: "Recife - PE"
  transportMode   String?   // "aviao" | "carro"
  interests       String?   // "Praia", "Gastronomia", etc
  travelStyle     String?   // "Conforto" ou "Aventura"
  groupType       String?   // "solo", "casal", "família com crianças", etc
  touristProfile  String?   // resultado da classificação interna (Fase 3)
  destination     String?   // ex: "João Pessoa - PB", "Lisboa", "Paris"

  // Controle de fluxo
  phase           Int      @default(1)  // 1=apresentação, 2=onboarding, 3=classificado, 4=gerou roteiro, 5=pós-pagamento
  onboardingStep  Int      @default(0)  // qual das 5 perguntas estamos (0 a 5)
  hasPaid         Boolean  @default(false)
  freeCredits     Int      @default(0)  // créditos grátis disponíveis

  // Afiliação / indicação
  referralCode    String?  @unique       // código único desta conversa para compartilhar
  referredBy      String?               // código de quem indicou este usuário

  // Sol Acompanhante
  hasCompanion    Boolean  @default(false)  // comprou o plano de acompanhamento em tempo real

  // Histórico de mensagens (memória de curto prazo)
  messages  Message[]

  // Roteiros gerados
  itineraries Itinerary[]
}

// Cada mensagem trocada na conversa
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String  // "user" | "assistant" | "system"
  content String  @db.Text
  
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// Roteiros gerados e pagamentos
model Itinerary {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  days          Int
  pdfUrl        String?
  paymentId     String?   // ID do pagamento no Abacate Pay
  status        String    @default("pending")  // "pending" | "paid" | "generated" | "sent"
  
  rawItinerary  String?   @db.Text  // texto gerado pelo agente
  storyPhotoUrl String?             // URL da foto enviada pelo cliente para o story

  // Snapshot da viagem no momento da criação (histórico multi-viagem do cliente)
  destination    String?
  arrivalDate    String?
  departureDate  String?
  groupType      String?
  touristProfile String?

  // Registro em texto livre de locais que o cliente mencionou já ter visitado (Sol Guia)
  visitedNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Registro de custo de cada chamada de API (OpenAI/Gemini) — base do painel de custos
model ApiUsage {
  id             String   @id @default(cuid())
  phone          String?  // sem relação obrigatória — logging nunca deve falhar por causa de FK
  conversationId String?
  itineraryId    String?

  provider String // "openai" | "google"
  model    String // ex: "gpt-4.1-mini", "gemini-2.5-flash"
  callType String // "chat" | "itinerary" | "grounded_search" | "classify_days" | "track_visited"

  inputTokens    Int
  outputTokens   Int
  thinkingTokens Int   @default(0) // tokens de raciocínio do Gemini, cobrados como output
  costUsd        Float

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
  @@index([callType])
}
