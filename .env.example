# ==========================================
# SOL AGENT - Variáveis de Ambiente
# Copie para .env e preencha os valores
# ==========================================

# Banco de dados (Railway Postgres)
DATABASE_URL="postgresql://user:password@host:5432/soldb"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="https://sua-evolution-api.com"
EVOLUTION_API_KEY="sua-chave-aqui"
EVOLUTION_INSTANCE="nome-da-instancia"

# Abacate Pay
ABACATEPAY_TOKEN="seu-token-abacatepay"
ABACATEPAY_WEBHOOK_SECRET="seu-secret-webhook"

# Supabase (para PDF)
SUPABASE_URL="https://cegfnjiqqalvoczehtlu.supabase.co"
SUPABASE_ANON_KEY="sua-chave-supabase"

# Links de pagamento por quantidade de dias
# Formato: PAYMENT_LINK_1=https://...
PAYMENT_LINK_1="https://abacatepay.com/pay/link-1-dia"
PAYMENT_LINK_2="https://abacatepay.com/pay/link-2-dias"
PAYMENT_LINK_3="https://abacatepay.com/pay/link-3-dias"
PAYMENT_LINK_5="https://abacatepay.com/pay/link-5-dias"
PAYMENT_LINK_7="https://abacatepay.com/pay/link-7-dias"
PAYMENT_LINK_10="https://abacatepay.com/pay/link-10-dias"
PAYMENT_LINK_15="https://abacatepay.com/pay/link-15-dias"

# Porta do servidor
PORT=3000
