# ==========================================
# SOL AGENT - Variáveis de Ambiente
# Copie para .env e preencha os valores
# ==========================================

# Banco de dados (Railway Postgres)
DATABASE_URL="postgresql://user:password@host:5432/soldb"

# OpenAI (Sol — conversa principal)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.4-mini"

# -----------------------------------------------
# Meta WhatsApp Business API (API Oficial)
# Onde encontrar:
#   META_ACCESS_TOKEN   → Meta for Developers → App → WhatsApp → API Setup → "Temporary access token"
#                         (para produção: gere um token permanente via System User)
#   META_PHONE_NUMBER_ID → mesmo painel, campo "Phone number ID"
#   META_VERIFY_TOKEN   → você escolhe qualquer string. Ex: "sol_webhook_2024"
#                         Use o mesmo valor aqui e no painel da Meta ao configurar o webhook
# -----------------------------------------------
META_ACCESS_TOKEN="EAAxxxxxxx..."
META_PHONE_NUMBER_ID="12345678901234"
META_VERIFY_TOKEN="sol_webhook_2024"

# -----------------------------------------------
# Google AI (Gemini — gerador de roteiros com busca web)
# Onde encontrar: https://aistudio.google.com/app/apikey
# -----------------------------------------------
GOOGLE_API_KEY="AIzaSy..."
GOOGLE_MODEL="gemini-2.0-flash"

# Supabase (para PDF e créditos)
SUPABASE_URL="https://cegfnjiqqalvoczehtlu.supabase.co"
SUPABASE_ANON_KEY="sua-chave-supabase"

# Abacate Pay
ABACATEPAY_TOKEN="seu-token-abacatepay"
ABACATEPAY_WEBHOOK_SECRET="seu-secret-webhook"

# Links de pagamento por quantidade de dias
PAYMENT_LINK_1="https://abacatepay.com/pay/link-1-dia"
PAYMENT_LINK_2="https://abacatepay.com/pay/link-2-dias"
PAYMENT_LINK_3="https://abacatepay.com/pay/link-3-dias"
PAYMENT_LINK_5="https://abacatepay.com/pay/link-5-dias"
PAYMENT_LINK_7="https://abacatepay.com/pay/link-7-dias"
PAYMENT_LINK_10="https://abacatepay.com/pay/link-10-dias"
PAYMENT_LINK_15="https://abacatepay.com/pay/link-15-dias"

# Porta do servidor
PORT=3000
